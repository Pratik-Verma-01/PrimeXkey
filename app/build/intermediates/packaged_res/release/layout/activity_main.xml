<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate New Keystore"
            android:textColor="@color/on_surface"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/space_grotesk_family" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Initialize a secure JKS file for application signing."
            android:textColor="@color/outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KEY ALIAS"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/space_grotesk_family" />

            <EditText
                android:id="@+id/etAlias"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_glass"
                android:hint="e.g. production_release"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="STORE PASSWORD"
                android:textColor="@color/outline"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/space_grotesk_family" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_glass"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline_variant" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/outline_variant" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/input_glass"
                android:hint="Full Name"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline_variant" />

            <EditText
                android:id="@+id/etOrganization"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_glass"
                android:hint="Organization"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline_variant" />

            <EditText
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_glass"
                android:hint="City/Locality"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/outline_variant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VALIDITY PERIOD"
                    android:textColor="@color/primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/space_grotesk_family" />

                <TextView
                    android:id="@+id/tvYears"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="25 Years"
                    android:textColor="@color/secondary"
                    android:textStyle="bold"
                    android:fontFamily="@font/space_grotesk_family" />
            </RelativeLayout>

            <SeekBar
                android:id="@+id/sbValidity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="30"
                android:progress="25"
                android:progressTint="@color/secondary"
                android:thumbTint="@color/secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCreate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_gradient"
            android:text="CREATE JKS FILE"
            android:textColor="@color/background"
            android:textStyle="bold"
            android:backgroundTint="@null"
            android:fontFamily="@font/space_grotesk_family" />

    </LinearLayout>
</ScrollView>
